#define IDR_HOOK_DLL  101
#define IDI_APP_ICON  200

IDI_APP_ICON  ICON    "@ICON_PATH@"
IDR_HOOK_DLL  RCDATA  "@HOOK_DLL_PATH@"

// Embed manifest so Windows UAC prompts for admin on launch
1 RT_MANIFEST "@MANIFEST_PATH@"

// Embed version information resource
1 VERSIONINFO
FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Instant Replay Patcher"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "IRPatcher"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Abosmra"
            VALUE "OriginalFilename", "IRPatcher.exe"
            VALUE "ProductName",      "Instant Replay Patcher"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

